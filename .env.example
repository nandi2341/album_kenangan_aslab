# ==============================================================================
# A Chapter to Remember — Environment Variables Template
# Digital Memory Album: Aslab FKOM Universitas Kuningan 2026–2027
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk development lokal:
#   copy .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL PUBLIK SITUS
# ------------------------------------------------------------------------------
# Digunakan untuk metadata OpenGraph, canonical URL, dan absolute URL aset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SANITY CMS — KONFIGURASI FRONTEND (NEXT.JS)
# ------------------------------------------------------------------------------
# Project ID dari akun Sanity (dapat dilihat di https://sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=3ljc5pq3

# Dataset Sanity yang digunakan (default: production)
NEXT_PUBLIC_SANITY_DATASET=production

# Versi Sanity API (format tanggal ISO YYYY-MM-DD, default: 2025-01-01)
SANITY_API_VERSION=2025-01-01

# [Opsional] Read Token jika dataset bersifat privat
SANITY_API_READ_TOKEN=

# [Wajib jika ingin menerima Buku Tamu] Server-side Write Token
# Buat token dengan role "Editor" di Sanity Manage -> API -> Tokens.
# JANGAN PERNAH gunakan prefix NEXT_PUBLIC_ untuk token ini!
SANITY_API_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 3. SANITY STUDIO — KONFIGURASI CMS ADMIN (/studio)
# ------------------------------------------------------------------------------
# Digunakan saat menjalankan studio mandiri di dalam folder `studio/`
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
